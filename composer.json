{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "awcodes/filament-curator": "3.7.11",
        "bezhansalleh/filament-shield": "3.9.10",
        "bostjanob/filament-file-manager": "0.1",
        "filament/filament": "3.3.43",
        "filament/spatie-laravel-media-library-plugin": "3.3.43",
        "filament/spatie-laravel-settings-plugin": "3.3.43",
        "guzzlehttp/guzzle": "7.10.0",
        "laravel/framework": "10.49.1",
        "laravel/sanctum": "3.3.3",
        "laravel/tinker": "2.10.1",
        "laravel/ui": "4.6.1",
        "propaganistas/laravel-phone": "5.3.6",
        "ryangjchandler/filament-navigation": "1.0.0-beta6",
        "sirodiaz/laravel-redirection": "2.0.1",
        "smsaero/smsaero_api": "1.1.0",
        "spatie/eloquent-sortable": "4.5.2",
        "spatie/laravel-backup": "8.8.2",
        "spatie/laravel-settings": "3.4.1",
        "spatie/laravel-sitemap": "6.4.0",
        "spatie/laravel-sluggable": "3.7.5",
        "spatie/pdf-to-image": "2.3.0",
        "spatie/schema-org": "3.23.1"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "3.16.0",
        "fakerphp/faker": "1.24.1",
        "laravel/envoy": "2.10.2",
        "laravel/pint": "1.20.0",
        "laravel/sail": "1.47.0",
        "mockery/mockery": "1.6.12",
        "nunomaduro/collision": "7.12.0",
        "phpunit/phpunit": "10.5.58",
        "spatie/laravel-ignition": "2.9.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [ "app/Helpers/helper.php" ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan filament:upgrade"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.1.22"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
